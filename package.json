{
  "name": "parkbot-api",
  "version": "1.9.0",
  "description": "parkbot backend",
  "scripts": {
    "api": "nodemon aps/ae/daman/api/index.js",
    "dev": "nodemon aps/us/menloa/index.js",
    "start": "NODE_ENV=production pm2 start aps/us/menloa/index.js --name api-menlo-a --max-memory-restart 128M",
    "test": "standard",
    "uWS": "npm i uWebSockets.js@uNetworking/uWebSockets.js#v20.69.0",
    "test:uws": "node --test test/uws.integration.test.js",
    "test:auth": "node --test --experimental-test-isolation=none test/auth-permissions.test.js test/router-auth.test.js test/better-auth-session.test.js",
    "test:plc": "node --test --experimental-test-isolation=none test/daman-plcw.test.js test/utils7.test.js",
    "test:startup": "node --test --experimental-test-isolation=none test/startup.test.js",
    "test:db": "node --test --experimental-test-isolation=none test/db.test.js",
    "test:json": "node --test --experimental-test-isolation=none test/json.test.js"
  },
  "author": "f.riva@sotefin.ch",
  "license": "MIT",
  "dependencies": {
    "better-auth": "1.7.9",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "mongodb": "^7.6.0",
    "mqtt": "^5.10.3",
    "node-snap7": "^1.0.9",
    "pino": "^10.3.1",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "standard": "^17.1.2"
  },
  "standard": {
    "ignore": [
      "/node_modules/**",
      "/public"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module"
}
